# Port the HTTP server listens on (Railway injects this automatically).
PORT=3000

# Public origin of the site; used in emails, links and the CSRF origin check.
# Cookies are always Secure: for local development use http://localhost (Chromium and
# Firefox accept Secure cookies there; Safari does not).
BASE_URL=https://amigoocultosimples.app

# SQLite database. On Railway: sqlite:///app/data/amigo_oculto_v2.db (volume mount).
DATABASE_URL=sqlite:./dev.db

# Litestream (production only; unset = no replication). LITESTREAM_PATH is the prefix inside
# the bucket — production uses v2, test services must use their own prefix.
LITESTREAM_BUCKET=
LITESTREAM_PATH=
LITESTREAM_ENDPOINT=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# smtp to really send email (SMTP_HOST/SMTP_PORT/SMTP_USERNAME/SMTP_PASSWORD/SMTP_FROM),
# log to print mail to stdout instead. Defaults to log without SMTP_HOST.
MAIL_TRANSPORT=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=naoresponda@amigoocultosimples.app

# Emails allowed to log into /admin via magic link (comma-separated).
ADMIN_EMAILS=

# Trust X-Forwarded-For / CF-Connecting-IP for rate limiting (true on Railway).
TRUST_PROXY=true

# Days after the event date before a game is deleted.
GAME_RETENTION_DAYS=90

RUST_LOG=info
